{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/Steeey1/FIT3179/refs/heads/main/Week9homework/data/au-water-industryandhome.csv"
  },
  "repeat": {"layer": ["Industry", "Households"]},
  "spec": {
    "mark": "bar",
    "encoding": {
      "x": {"field": "State", "type": "nominal", "title": "State"},
      "y": {
        "field": {"repeat": "layer"},
        "type": "quantitative",
        "title": "Water Usage"
      },
      "color": {"datum": {"repeat": "layer"}, "title": "Channel"},
      "xOffset": {"datum": {"repeat": "layer"}},
      "tooltip": [
        {"field": "State", "type": "nominal", "title": "State"},
        {"field": {"repeat": "layer"}, "type": "quantitative", "title": "Water Usage"},
        {"datum": {"repeat": "layer"}, "title": "Type"}
      ]
    }
  },
  "transform": [
    {
      "filter": "State_selection == null ? true : datum.State == State_selection"
    }
  ],
  "params": [
    {
      "name": "State_selection",
      "bind": {
        "input": "select",
        "options": [
          null,
          "Victoria",
          "Queensland",
          "Tasmania",
          "New South Wales",
          "Western Australia",
          "South Australia",
          "Northern Territory",
          "Australian Capital Territory"
        ],
        "labels": [
          "Show All",
          "Victoria",
          "Queensland",
          "Tasmania",
          "New South Wales",
          "Western Australia",
          "South Australia",
          "Northern Territory",
          "Australian Capital Territory"
        ],
        "name": "State Selection:"
      }
    }
  ],
  "config": {"mark": {"invalid": null}}
}
